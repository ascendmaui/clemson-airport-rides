+/// Wraps a raw pointer that is only used synchronously inside `JavaScriptActor.assumeIsolated`.
+/// Swift 6.2.x (Xcode 26.2/26.3) rejects capturing `nonisolated(unsafe) let` pointers in the
+/// actor-isolated closure ("sending ... risks causing data races"); Swift 6.3 accepts it.
+/// A zero-cost `@unchecked Sendable` struct keeps the same semantics without heap allocation.
+@usableFromInline
+internal struct UnsafeSendablePointer<Pointer>: @unchecked Sendable {
+  @usableFromInline let value: Pointer
+  @inline(__always) @usableFromInline init(_ value: Pointer) { self.value = value }
+}
