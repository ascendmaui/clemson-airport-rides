{
  "expo": {
    "name": "Clemson RIDES Driver",
    "slug": "clemson-rides-driver",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clemsonrides-driver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "17",
      "bundleIdentifier": "com.ascendmaui.clemsonrides.driver",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.ascendmaui.clemsonrides.driver",
      "adaptiveIcon": {
        "backgroundColor": "#522D80",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Clemson RIDES uses your location while you are online so riders can see your car on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Clemson RIDES uses your photo library for license, insurance, and vehicle documents.",
          "cameraPermission": "Clemson RIDES uses the camera to photograph driver documents."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F56600",
          "sounds": ["./assets/sounds/request.wav"]
        }
      ],
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#522D80"
        }
      ],
      "@clerk/expo",
      "@clerk/expo-google-signin"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "090d10b8-2f52-4502-ac9d-e8bd0fe35033"
      }
    },
    "owner": "johnmatveyev"
  }
}
