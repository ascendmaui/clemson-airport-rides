EXPO_PUBLIC_SUPABASE_URL=https://awktabuhijrshmsmagpq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Apple & Google sign-in use Supabase Auth directly.
# Supabase configuration:
# - Apple provider: client ID com.ascendmaui.clemsonrides.driver (Team ID: L85AF3V872)
# - Google provider: Google OAuth web client credentials under ascendmaui (iOS client ID optional)
# - Redirect allowlist: clemsonrides-driver://** (Google signInWithOAuth returns to clemsonrides-driver://auth/callback)
# - Apple sign-in: native token via signInWithIdToken (no browser redirect)
# - Resend SMTP configured in Supabase for transactional auth emails
# Password reset redirect: clemsonrides-driver://set-password

# Optional Google client ids. Driver Continue with Google uses Supabase Auth
# and does not require these values in the app binary.

EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional. Defaults to the production web app so earnings and trip settle hit existing /api routes.
EXPO_PUBLIC_API_BASE=https://clemsonrides.com

# Android map tiles. app.config.js writes this into the manifest when it is set.
# Restrict the key to com.ascendmaui.clemsonrides.driver and the upload-key SHA-1.
# Leave empty to show the in-app fallback instead of a blank map.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
