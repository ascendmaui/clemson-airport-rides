{
  "expo": {
    "name": "Clemson Rides",
    "slug": "clemson-rides-rider",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clemsonrides",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/ios-icon-light.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      },
      "usesAppleSignIn": true,
      "buildNumber": "19",
      "bundleIdentifier": "com.ascendmaui.clemsonrides.rider",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Clemson Rides uses your location to set your pickup point and show your driver approaching.",
        "NSMicrophoneUsageDescription": "Clemson Rides uses the microphone only when you start an audio or video recording during an active ride. The clip stays on this phone.",
        "NSCameraUsageDescription": "Clemson Rides uses the camera only when you start a video recording during an active ride. The clip stays on this phone."
      },
      "associatedDomains": [
        "applinks:clemsonrides.com",
        "applinks:www.clemsonrides.com"
      ]
    },
    "android": {
      "package": "com.ascendmaui.clemsonrides.rider",
      "versionCode": 19,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F56600",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "clemsonrides.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.clemsonrides.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F56600"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Clemson Rides uses your location to set your pickup point and show your driver approaching.",
          "motionUsagePermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F56600"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Clemson Rides uses the microphone only when you start an audio or video recording during an active ride. The clip stays on this phone.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Clemson Rides keeps a video you start during an active ride on this phone. It does not browse your photo library or upload the clip.",
          "cameraPermission": "Clemson Rides uses the camera only when you start a video recording during an active ride. The clip stays on this phone.",
          "microphonePermission": "Clemson Rides uses the microphone only when you start an audio or video recording during an active ride. The clip stays on this phone."
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d02319c9-69ef-4523-a0a5-6712c037d5fa"
      }
    },
    "owner": "johnmatveyev"
  }
}
