EXPO_PUBLIC_SUPABASE_URL=https://awktabuhijrshmsmagpq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Apple & Google sign-in use Supabase Auth directly.
# Supabase configuration:
# - Apple provider: client ID com.ascendmaui.clemsonrides.rider (Team ID: L85AF3V872)
# - Google provider: Google OAuth web client credentials under ascendmaui
# - Redirect allowlist: clemsonrides://** (Google signInWithOAuth returns to clemsonrides://auth/callback)
# - Apple sign-in: native token via signInWithIdToken (no browser redirect)
# - Resend SMTP configured in Supabase for transactional auth emails
# Password reset redirect: clemsonrides://set-password

# Google OAuth client IDs (leave empty until configured; Google sign-in gates on these)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_API_BASE=https://clemsonrides.com

# Android map tiles. app.config.js writes this into the manifest when it is set.
# Restrict the key to com.ascendmaui.clemsonrides.rider and the upload-key SHA-1.
# Leave empty to show the in-app fallback instead of a blank map.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
