EXPO_PUBLIC_SUPABASE_URL=https://awktabuhijrshmsmagpq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Clerk publishable key (pk_test_ or pk_live_). Safe to ship in the binary. Never put sk_ here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Reversed iOS Google client id, for example com.googleusercontent.apps.123. Native Google Sign-In needs this at build time.
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
