{
  "expo": {
    "name": "Clemson RIDES",
    "slug": "clemson-rides-rider",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clemsonrides",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "buildNumber": "19",
      "bundleIdentifier": "com.ascendmaui.clemsonrides.rider",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Clemson RIDES uses your location to set a current-location pickup, center the campus map, share a trip link you send, and attach GPS when you confirm an SOS."
      },
      "associatedDomains": [
        "applinks:clemsonrides.com",
        "applinks:www.clemsonrides.com"
      ]
    },
    "android": {
      "package": "com.ascendmaui.clemsonrides.rider",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F56600",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "clemsonrides.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.clemsonrides.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Clemson RIDES uses your location to set a current-location pickup, center the campus map, share a trip link you send, and attach GPS when you confirm an SOS."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F56600"
        }
      ],
      "expo-audio",
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d02319c9-69ef-4523-a0a5-6712c037d5fa"
      }
    },
    "owner": "johnmatveyev"
  }
}
