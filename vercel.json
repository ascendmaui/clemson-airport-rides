{
  "rewrites": [
    {
      "source": "/api/stripe/webhook",
      "destination": "/api/stripe-webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/driver-payouts",
      "schedule": "*/15 * * * *"
    }
  ]
}
