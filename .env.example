# === Supabase (project awktabuhijrshmsmagpq) ===
VITE_SUPABASE_URL=https://awktabuhijrshmsmagpq.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
NEXT_PUBLIC_SUPABASE_URL=https://awktabuhijrshmsmagpq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Server-only (Vercel /api) — never VITE_* or EXPO_PUBLIC_*
SUPABASE_URL=https://awktabuhijrshmsmagpq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# === Stripe (client) ===
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# === Stripe (server — Vercel serverless /api only) ===
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# === Google Maps ===
# Browser (Maps JavaScript API — referrer-restricted OK). Tiles blank until billed key.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key_here
# Server (Routes API computeRoutes) — set on Vercel. NOT the Vite browser key alone.
GOOGLE_MAPS_API_KEY=your_server_routes_api_key_here

# === Google OAuth (Native apps client IDs — leave empty until configured) ===
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional
VITE_APP_URL=https://clemsonrides.com

# Driver-application email. The in-app dashboard at #/admin works without these.
# TODO: set RESEND_API_KEY + RESEND_FROM (verified domain). Comma-separated.
# Recipients come only from ADMIN_NOTIFY_EMAIL. Unset sends nothing.
ADMIN_NOTIFY_EMAIL=
# Comma-separated server allow-list for admin API checks, in addition to
# profiles.role admin/ops or profiles.is_admin. Not read by the browser.
ADMIN_EMAILS=
RESEND_API_KEY=
RESEND_FROM=
# The admin "Email agreement to driver for signature" button uses the same
# RESEND_API_KEY and RESEND_FROM. When either is empty the API returns
# "Email sender not configured" and a copyable signing link. It does not
# send mail on application submit.

# Driver push. EXPO_ACCESS_TOKEN lets the API call Expo's push service.
# iOS still needs an APNs key, and Android an FCM key, on the Expo project.
# Those Apple/Google credentials are not stored here. Without them a locked
# phone will not show the system toast even after the token is saved.
EXPO_ACCESS_TOKEN=
# Driver-offer SMS/email are off unless the value is exactly "send".
DRIVER_OFFER_ALERT_SMS=
DRIVER_OFFER_ALERT_EMAIL=
# DRIVER_OFFER_ALERT_SMS_MAX_PER_HOUR=6
# DRIVER_OFFER_ALERT_EMAIL_MAX_PER_HOUR=6
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

# === Help + Support agents (Vercel /api only — never VITE_*) ===
# Set one. If both are set, AI_GATEWAY_API_KEY wins.
# AI Gateway model ids look like openai/gpt-4o-mini.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
HELP_CHAT_MODEL=gpt-4o-mini
# Comma-separated emails that can list every support ticket (support inbox).
# Seeded admins can already list tickets. This adds support-only readers. Not a password.
SUPPORT_ADMIN_EMAILS=
# Optional label for the in-app inbox. Leave empty. Do not put a mailbox password here.
SUPPORT_INBOX_EMAIL=

# Bearer for cron routes (/api/expire-unpaid-airport-holds, /api/driver-payouts).
# The same value must be set in three places: Vercel prod, Supabase Vault
# secret clemson_cron_secret, and /opt/clemson-rides/.env on the VPS.
# Do not set VERCEL on the VPS. See docs/self-hosting.md.
CRON_SECRET=
# Leave these unset in the shared VPS env file. The staging compose service
# sets them on that container only. DISABLE_CRON_ENDPOINTS=1 returns 403 for
# payout, hold-expiry, and rebroadcast cron calls. ALLOW_STAGING_DRY_RUN=1
# lets dry-run through. Production must not set either.
# DISABLE_CRON_ENDPOINTS=
# ALLOW_STAGING_DRY_RUN=
