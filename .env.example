# === Supabase (project awktabuhijrshmsmagpq) ===
VITE_SUPABASE_URL=https://awktabuhijrshmsmagpq.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
NEXT_PUBLIC_SUPABASE_URL=https://awktabuhijrshmsmagpq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Server-only (Vercel /api) — never VITE_* or EXPO_PUBLIC_*
SUPABASE_URL=https://awktabuhijrshmsmagpq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# === Stripe (client) ===
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# Public key. The rider app PaymentSheet reads it from the setup-intent response.
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# Apple Pay merchant id, for example merchant.com.ascendmaui.clemsonrides.
# Leave empty until the id exists in Apple Developer and Stripe.
STRIPE_MERCHANT_IDENTIFIER=
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=

# === Stripe (server — Vercel serverless /api only) ===
# Crimson Rides Stripe account, TEST MODE ONLY. Never a live key and never a
# ScreenshotSticky key. Affiliate Connect (Express onboarding, Transfers) reads
# this same STRIPE_SECRET_KEY. A live key refuses to create accounts or transfer.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Optional. Affiliate Connect events can share STRIPE_WEBHOOK_SECRET on
# /api/stripe/webhook, or use a separate signing secret on
# /api/stripe/connect-webhook. Subscribe to account.updated, transfer.created,
# transfer.updated, transfer.reversed, payout.created, payout.updated,
# payout.paid, payout.failed, and payout.canceled.
# STRIPE_CONNECT_WEBHOOK_SECRET=
# Tiger Pass is $9.99/month from TIGER_PASS_PRICE_CENTS in shared/tigerPass.js.
# Checkout creates the subscription line item with price_data (mode subscription).
# No Stripe Price id env var. Webhook events: checkout.session.completed,
# invoice.paid, customer.subscription.updated, customer.subscription.deleted.
# Only events whose metadata kind is tiger_pass update rider_subscriptions.

# === Google Maps ===
# Browser (Maps JavaScript API — referrer-restricted OK). Tiles blank until billed key.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key_here
# Server (Routes API computeRoutes) — set on Vercel. NOT the Vite browser key alone.
GOOGLE_MAPS_API_KEY=your_server_routes_api_key_here

# === Google OAuth (Native apps client IDs — leave empty until configured) ===
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional
VITE_APP_URL=https://clemsonrides.com

# Driver-application email. The in-app dashboard at #/admin works without these.
# TODO: set RESEND_API_KEY + RESEND_FROM (verified domain). Comma-separated.
# Recipients come only from ADMIN_NOTIFY_EMAIL. Unset sends nothing.
ADMIN_NOTIFY_EMAIL=
# Comma-separated server allow-list for admin API checks, in addition to
# profiles.role admin/ops or profiles.is_admin. Not read by the browser.
ADMIN_EMAILS=
RESEND_API_KEY=
RESEND_FROM=
# Reply-To on every Resend send, and the public support contact.
# Defaults to rides@clemsonrides.com when unset. Do not put a different mailbox here
# unless that mailbox should replace the support contact everywhere.
SUPPORT_EMAIL=
# Optional web alias of SUPPORT_EMAIL. The Vite build also reads SUPPORT_EMAIL.
VITE_SUPPORT_EMAIL=
# The admin "Email agreement to driver for signature" button uses the same
# RESEND_API_KEY and RESEND_FROM. When either is empty the API returns
# "Email sender not configured" and a copyable signing link. It does not
# send mail on application submit.

# Driver push. The API posts to Expo without this token while Enhanced
# Security for Push is off. Set EXPO_ACCESS_TOKEN if that Expo setting is
# later enabled. iOS still needs an APNs key, and Android an FCM key, on
# the Expo project. Those Apple/Google credentials are not stored here.
# Without them a locked phone will not show the system toast even after
# the device token is saved.
EXPO_ACCESS_TOKEN=
# Driver-offer SMS/email are off unless the value is exactly "send".
DRIVER_OFFER_ALERT_SMS=
DRIVER_OFFER_ALERT_EMAIL=
# DRIVER_OFFER_ALERT_SMS_MAX_PER_HOUR=6
# DRIVER_OFFER_ALERT_EMAIL_MAX_PER_HOUR=6
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

# === Help + Support agents (Vercel /api only — never VITE_*) ===
# Set one. If both are set, AI_GATEWAY_API_KEY wins.
# AI Gateway model ids look like openai/gpt-4o-mini.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
HELP_CHAT_MODEL=gpt-4o-mini
# Driver profile photos prefer the AI Gateway above. If only OPENAI_API_KEY
# is set, that existing key is used. If neither key is set, every photo goes
# to the admin queue. Set off to skip the fallback notification.
# DRIVER_PROFILE_PHOTO_ADMIN_FALLBACK=on
# Driver documents (license, insurance, registration, inspection) use a direct
# NVIDIA connection. They do not use OPENAI_API_KEY or the AI Gateway.
# If NVIDIA_API_KEY is empty, every document waits for manual review.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default meta/llama-3.2-11b-vision-instruct. On 2026-10-13 the 90B vision
# model timed out and nvidia/nemotron-nano-12b-v2-vl returned HTTP 410.
# Each call waits about 20s. A timeout, HTTP 5xx, 404, or 410 tries the next
# model, including Nemotron when NVIDIA serves it again.
NVIDIA_DOC_MODEL=meta/llama-3.2-11b-vision-instruct
# Comma-separated emails that can list every support ticket (support inbox).
# Seeded admins can already list tickets. This adds support-only readers. Not a password.
SUPPORT_ADMIN_EMAILS=
# Optional label for the in-app inbox. Leave empty. Do not put a mailbox password here.
SUPPORT_INBOX_EMAIL=

# Bearer for cron routes (/api/expire-unpaid-airport-holds, /api/driver-payouts).
# The same value must be set in three places: Vercel prod, Supabase Vault
# secret clemson_cron_secret, and /opt/clemson-rides/.env on the VPS.
# Do not set VERCEL on the VPS. See docs/self-hosting.md.
CRON_SECRET=
# Leave these unset in the shared VPS env file. The staging compose service
# sets them on that container only. DISABLE_CRON_ENDPOINTS=1 returns 403 for
# payout, hold-expiry, and rebroadcast cron calls. ALLOW_STAGING_DRY_RUN=1
# lets dry-run through. Production must not set either.
# DISABLE_CRON_ENDPOINTS=
# ALLOW_STAGING_DRY_RUN=
